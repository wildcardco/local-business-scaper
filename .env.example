# ===========================================
# Wild Card Lead Gen - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# DATABASE
# -------------------------------------------
# SQLite database file location (relative to project root)
DATABASE_URL="file:./dev.db"

# -------------------------------------------
# RAPIDAPI - Local Business Data
# -------------------------------------------
# Required for business search functionality
# Get your key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/local-business-data
RAPIDAPI_KEY=a3513ec15cmsh0abebf97dd7bc2fp1e4effjsna60aa8da446b
RAPIDAPI_HOST=local-business-data.p.rapidapi.com

# -------------------------------------------
# GOOGLE PAGESPEED INSIGHTS
# -------------------------------------------
# Optional - API works without key but has stricter rate limits
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable the PageSpeed Insights API in your Google Cloud project
GOOGLE_PAGESPEED_API_KEY=

# -------------------------------------------
# MAILGUN - Email Outreach
# -------------------------------------------
# Required for sending outreach emails
# Get your credentials at: https://app.mailgun.com/
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=outreach.wildcardcreativeco.com

# -------------------------------------------
# N8N - Automation Webhooks
# -------------------------------------------
# Optional - For sending leads to n8n automation workflows
# Create a webhook trigger in n8n and paste the URL here
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id
